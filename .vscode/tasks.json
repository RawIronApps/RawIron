{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve RawIron site",
            "type": "shell",
            "command": "python3",
            "args": ["-u", "-m", "http.server", "8081", "--bind", "127.0.0.1"],
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            // Tells VS Code the server is ready once it prints its startup line,
            // so the debugger doesn't open Chrome before the port is listening.
            // - activeOnStart marks the task as started immediately; the
            //   beginsPattern is a placeholder that never matches, because
            //   VS Code skips the end check on a line that matches the begin.
            // - The pattern is a required placeholder that never matches
            //   server output, so nothing is reported in the Problems panel.
            // - No "^" anchor on endsPattern, because terminal
            //   shell-integration codes can precede the text.
            "problemMatcher": {
                "owner": "http-server",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^__never_matches__(.*):(\\d+):(.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^__never_matches__$",
                    "endsPattern": "Serving HTTP on"
                }
            },
            "presentation": { "reveal": "silent", "panel": "dedicated" }
        },
        {
            "label": "Stop RawIron server",
            "command": "${input:terminateServer}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "terminateServer",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Serve RawIron site"
        }
    ]
}
